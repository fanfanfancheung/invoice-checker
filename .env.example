# ============================================================
#  飞书邮件发票下载器 · 配置文件
#  复制本文件为 .env，然后填写下面的值
# ============================================================

# ── 飞书开放平台应用凭证 ─────────────────────────────────────
# 1. 进入 https://open.feishu.cn/app，创建一个「企业自建应用」
# 2. 在「凭证与基础信息」页面获取 App ID 和 App Secret
# 3. 在「权限管理」中开启以下权限：
#      mail:user_mailbox.message:read_only   （读取邮件）
#      mail:user_mailbox.attachment:download （下载附件）
# 4. 在「安全设置 > 重定向 URL」中添加你的回调地址（如有需要）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 要访问的邮箱地址 ──────────────────────────────────────────
# 填写你自己的飞书邮箱地址，例如: yourname@yourcompany.com
FEISHU_USER_EMAIL=yourname@yourcompany.com

# ── 用户访问令牌（推荐，用于访问个人邮箱） ──────────────────────
# 通过 OAuth 2.0 获取 user_access_token：
#   https://open.feishu.cn/document/ukTMukTMukTM/uMTNz4yM1MjLzUzM/authen/authorization_code
# 令牌有效期约 2 小时，过期后需重新获取
# 如果留空，将使用 tenant_access_token（需要管理员开启邮箱代读权限）
FEISHU_USER_ACCESS_TOKEN=

# ── 下载设置 ─────────────────────────────────────────────────
# 发票保存目录（相对路径或绝对路径）
DOWNLOAD_DIR=downloads

# 搜索最近多少天的邮件（0 = 全部历史邮件）
DAYS_BACK=30
